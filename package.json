{
  "name": "maplibre-versatiles-styler",
  "version": "2.0.2",
  "type": "module",
  "main": "dist/maplibre-versatiles-styler.umd.cjs",
  "module": "dist/maplibre-versatiles-styler.js",
  "types": "dist/maplibre-versatiles-styler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maplibre-versatiles-styler.d.ts",
      "import": "./dist/maplibre-versatiles-styler.js",
      "require": "./dist/maplibre-versatiles-styler.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && vite build",
    "check": "npm run format && npm run typecheck && npm run lint && npm run build && npm run test",
    "dev": "vite",
    "format:check": "prettier --check .",
    "format": "prettier --write --log-level warn .",
    "lint": "eslint --color .",
    "prepack": "npm run build",
    "preview": "vite preview",
    "release": "vrt release-npm",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "upgrade": "vrt deps-upgrade",
    "doc": "npm run build && npm run doc-bundle && npm run doc-graph",
    "doc-bundle": "vrt bundle-treemap dist/maplibre-versatiles-styler.js --depth 3 --min-size 5000 --svg assets/bundle-treemap.svg | vrt doc-insert README.md '### Bundle Composition'",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '### Dependency Graph'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.3",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@versatiles/release-tool": "^2.19.1",
    "@versatiles/style": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.1",
    "maplibre-gl": "^6.11.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
